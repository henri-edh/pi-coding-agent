<?xml version="1.0" encoding="UTF-8"?>
<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    
    <!-- Title -->
    <mxCell id="title" value="FlightScope Radar CI/CD Pipeline" style="fontSize=20;fontStyle=1;fillColor=none;strokeColor=none;;fontColor=#1a3a6b;" vertex="1" parent="1">
      <mxGeometry x="400" y="20" width="400" height="40" as="geometry"/>
    </mxCell>
    
    <!-- Trigger -->
    <mxCell id="start" value="Push to Repository" style="ellipse;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;;fontColor=#1a3a6b;" vertex="1" parent="1">
      <mxGeometry x="420" y="80" width="160" height="60" as="geometry"/>
    </mxCell>
    
    <!-- STAGE 1 HEADER -->
    <mxCell id="stage1-header" value="STAGE 1: Build + Unit Tests (All Branches)" style="rounded=0;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;;fontColor=#1a3a6b;" vertex="1" parent="1">
      <mxGeometry x="200" y="170" width="600" height="30" as="geometry"/>
    </mxCell>
    
    <!-- Stage 1 Steps -->
    <mxCell id="s1-cmake-host" value="CMake Configure (host)&#xa;TARGET=host, Debug" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;;fontColor=#1a3a6b;" vertex="1" parent="1">
      <mxGeometry x="220" y="220" width="140" height="60" as="geometry"/>
    </mxCell>
    
    <mxCell id="s1-build" value="CMake Build&#xa;Parallel 4-core" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;;fontColor=#1a3a6b;" vertex="1" parent="1">
      <mxGeometry x="400" y="220" width="140" height="60" as="geometry"/>
    </mxCell>
    
    <mxCell id="s1-cppcheck" value="cppcheck&#xa;--enable=all" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;;fontColor=#1a3a6b;" vertex="1" parent="1">
      <mxGeometry x="580" y="220" width="140" height="60" as="geometry"/>
    </mxCell>
    
    <mxCell id="s1-unit-test" value="CTest Unit Tests&#xa;Unity-based" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;;fontColor=#1a3a6b;" vertex="1" parent="1">
      <mxGeometry x="220" y="310" width="140" height="60" as="geometry"/>
    </mxCell>
    
    <mxCell id="s1-cross-compile" value="RPi Cross-Compile&#xa;arm-linux-gnueabihf&#xa;Produces .elf" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;;fontColor=#1a3a6b;" vertex="1" parent="1">
      <mxGeometry x="400" y="310" width="140" height="60" as="geometry"/>
    </mxCell>
    
    <!-- Branch Decision -->
    <mxCell id="branch-check" value="Branch Type?" style="rhombus;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;;fontColor=#1a3a6b;" vertex="1" parent="1">
      <mxGeometry x="420" y="420" width="120" height="100" as="geometry"/>
    </mxCell>
    
    <!-- Feature/Other branch path -->
    <mxCell id="feature-end" value="✓ Pass to CI&#xa;(No HIL)" style="ellipse;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;;fontColor=#1a3a6b;" vertex="1" parent="1">
      <mxGeometry x="220" y="440" width="120" height="60" as="geometry"/>
    </mxCell>
    
    <!-- STAGE 2 HEADER -->
    <mxCell id="stage2-header" value="STAGE 2: HIL Validation (develop + main only)" style="rounded=0;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;;fontColor=#1a3a6b;" vertex="1" parent="1">
      <mxGeometry x="520" y="420" width="400" height="30" as="geometry"/>
    </mxCell>
    
    <!-- Stage 2 Steps -->
    <mxCell id="s2-deploy" value="Deploy to RPi&#xa;SSH + SCP .elf&#xa;+ Golden Data" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;;fontColor=#1a3a6b;" vertex="1" parent="1">
      <mxGeometry x="540" y="470" width="140" height="70" as="geometry"/>
    </mxCell>
    
    <mxCell id="s2-hil-run" value="Run HIL Pass&#xa;MEM_READ Mode&#xa;Capture Results JSON" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;;fontColor=#1a3a6b;" vertex="1" parent="1">
      <mxGeometry x="720" y="470" width="140" height="70" as="geometry"/>
    </mxCell>
    
    <mxCell id="s2-evaluate" value="Evaluate vs Golden&#xa;Check Tolerances&#xa;Ball Speed, Spin, Angle" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;;fontColor=#1a3a6b;" vertex="1" parent="1">
      <mxGeometry x="540" y="580" width="140" height="70" as="geometry"/>
    </mxCell>
    
    <!-- Evaluation Decision -->
    <mxCell id="tolerance-check" value="Within&#xa;Tolerance?" style="rhombus;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;;fontColor=#1a3a6b;" vertex="1" parent="1">
      <mxGeometry x="720" y="585" width="100" height="80" as="geometry"/>
    </mxCell>
    
    <!-- Fail path -->
    <mxCell id="fail-build" value="✗ Fail Build&#xa;Report Deviation" style="ellipse;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;;fontColor=#1a3a6b;" vertex="1" parent="1">
      <mxGeometry x="900" y="600" width="120" height="60" as="geometry"/>
    </mxCell>
    
    <!-- Approval gate -->
    <mxCell id="approval-gate" value="Manual Approval Gate&#xa;Human Review&#xa;Merge Blockers?" style="rounded=1;whiteSpace=wrap;fillColor=#f0f0f0;strokeColor=#999999;fontSize=10;fontStyle=1;;fontColor=#1a3a6b;" vertex="1" parent="1">
      <mxGeometry x="540" y="710" width="140" height="70" as="geometry"/>
    </mxCell>
    
    <!-- Approval Decision -->
    <mxCell id="approval-check" value="Approved?" style="rhombus;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;;fontColor=#1a3a6b;" vertex="1" parent="1">
      <mxGeometry x="720" y="725" width="100" height="80" as="geometry"/>
    </mxCell>
    
    <!-- Reject -->
    <mxCell id="reject-approval" value="✗ Rejected&#xa;Changes Required" style="ellipse;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;;fontColor=#1a3a6b;" vertex="1" parent="1">
      <mxGeometry x="900" y="740" width="120" height="60" as="geometry"/>
    </mxCell>
    
    <!-- Success -->
    <mxCell id="merge-main" value="✓ Merge to main&#xa;Deploy to Production" style="ellipse;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;;fontColor=#1a3a6b;" vertex="1" parent="1">
      <mxGeometry x="540" y="850" width="140" height="70" as="geometry"/>
    </mxCell>
    
    <!-- Edges from trigger to Stage 1 -->
    <mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000;endArrow=standard;;fontColor=#1a3a6b;" edge="1" source="start" target="s1-cmake-host" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Stage 1 flow (horizontal) -->
    <mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000;endArrow=standard;;fontColor=#1a3a6b;" edge="1" source="s1-cmake-host" target="s1-build" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000;endArrow=standard;;fontColor=#1a3a6b;" edge="1" source="s1-build" target="s1-cppcheck" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000;endArrow=standard;;fontColor=#1a3a6b;" edge="1" source="s1-cmake-host" target="s1-unit-test" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000;endArrow=standard;;fontColor=#1a3a6b;" edge="1" source="s1-cppcheck" target="s1-cross-compile" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000;endArrow=standard;;fontColor=#1a3a6b;" edge="1" source="s1-unit-test" target="s1-cross-compile" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- To branch decision -->
    <mxCell id="edge7" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000;endArrow=standard;;fontColor=#1a3a6b;" edge="1" source="s1-cross-compile" target="branch-check" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Feature branch (left) -->
    <mxCell id="edge8" value="feature/*&#xa;other" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666;endArrow=standard;fontSize=9;;fontColor=#1a3a6b;" edge="1" source="branch-check" target="feature-end" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- develop/main branch (right) to Stage 2 -->
    <mxCell id="edge9" value="develop&#xa;main" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;endArrow=standard;fontSize=9;fontStyle=1;;fontColor=#1a3a6b;" edge="1" source="branch-check" target="s2-deploy" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Stage 2 flow -->
    <mxCell id="edge10" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;endArrow=standard;;fontColor=#1a3a6b;" edge="1" source="s2-deploy" target="s2-hil-run" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <mxCell id="edge11" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;endArrow=standard;;fontColor=#1a3a6b;" edge="1" source="s2-hil-run" target="s2-evaluate" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <mxCell id="edge12" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;endArrow=standard;;fontColor=#1a3a6b;" edge="1" source="s2-evaluate" target="tolerance-check" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Tolerance fail -->
    <mxCell id="edge13" value="No" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;endArrow=standard;fontSize=9;fontStyle=1;;fontColor=#1a3a6b;" edge="1" source="tolerance-check" target="fail-build" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Tolerance pass to approval -->
    <mxCell id="edge14" value="Yes" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;endArrow=standard;fontSize=9;fontStyle=1;;fontColor=#1a3a6b;" edge="1" source="tolerance-check" target="approval-gate" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Approval gate to approval decision -->
    <mxCell id="edge15" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666;endArrow=standard;;fontColor=#1a3a6b;" edge="1" source="approval-gate" target="approval-check" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Approval reject -->
    <mxCell id="edge16" value="No" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;endArrow=standard;fontSize=9;fontStyle=1;;fontColor=#1a3a6b;" edge="1" source="approval-check" target="reject-approval" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Approval accept -->
    <mxCell id="edge17" value="Yes" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;endArrow=standard;fontSize=9;fontStyle=1;;fontColor=#1a3a6b;" edge="1" source="approval-check" target="merge-main" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Legend -->
    <mxCell id="legend-title" value="Legend" style="fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;;fontColor=#1a3a6b;" vertex="1" parent="1">
