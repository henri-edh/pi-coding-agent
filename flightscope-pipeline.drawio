    </mxCell>
    
    <mxCell id="legend-success" value="Success" style="ellipse;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;;fontColor=#1a3a6b;" vertex="1" parent="1">
