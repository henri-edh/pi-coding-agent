    </mxCell>
    
    <mxCell id="legend-hil" value="HIL Step" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;;fontColor=#1a3a6b;" vertex="1" parent="1">
